# This is an example .env file.
# Add the missing values for the variables below.
# Then remove these comments and .example from the filename.
FILESTORE_TYPE=s3
AWS_DEFAULT_REGION=us-east-1
API_ROOT=
AUTH_TOKEN=
BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

SITE_PROXY_TOKEN=
SITE_PROXY_BASE_URL=
# --- Photon Ranch service endpoints -------------------------------------
# Defaults (in ptr_endpoints.py) are the local stack on loopback -- api 8091,
# status 8092, jobs 8093, calendar 8094, projects 8095, logs 8090/logs -- so
# leaving these unset keeps a run off LCO production.  See
# configs/dpo17/README.md for the dev wiring; a containerised site sets these
# to http://ptr-nginx:809x instead (ptr-site/sites/*.env).
#
# Set all six to reach LCO production:
#
# PTR_API_ROOT=https://api.photonranch.org/api
# PTR_STATUS_ROOT=https://status.photonranch.org/status
# PTR_JOBS_ROOT=https://jobs.photonranch.org/jobs
# PTR_LOGS_ROOT=https://logs.photonranch.org/logs
# PTR_CALENDAR_ROOT=https://calendar.photonranch.org/calendar
# PTR_PROJECTS_ROOT=https://projects.photonranch.org/projects

# Path to sourcextractor++ if it is not on PATH
# SOURCEXTRACTORPP=/usr/local/bin/sourcextractor++
