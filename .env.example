# This is an example .env file.
# Add the missing values for the variables below.
# Then remove these comments and .example from the filename.
FILESTORE_TYPE=s3
AWS_DEFAULT_REGION=us-east-1
API_ROOT=
AUTH_TOKEN=
BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

SITE_PROXY_TOKEN=
SITE_PROXY_BASE_URL=
# --- Photon Ranch service endpoints -------------------------------------
# Defaults (in ptr_endpoints.py) are the LCO production hosts, so leaving
# these unset keeps the previous behaviour.  Set them to run against a local
# stack.  See configs/dev/README.md for the dev-box wiring.
#
# PTR_API_ROOT=http://127.0.0.1:8091
# PTR_STATUS_ROOT=http://127.0.0.1:8090/status
# PTR_JOBS_ROOT=http://127.0.0.1:8090/jobs
# PTR_LOGS_ROOT=http://127.0.0.1:8090/logs
# PTR_CALENDAR_ROOT=http://127.0.0.1:8090/calendar
# PTR_PROJECTS_ROOT=http://127.0.0.1:8090/projects

# Path to sourcextractor++ if it is not on PATH
# SOURCEXTRACTORPP=/usr/local/bin/sourcextractor++
